# =============================================================================
# .env.example — copy to .env and fill in real values.
#   cp .env.example .env
#
# Every variable here is mapped by docker-entrypoint.sh into /app/config.yaml
# at container start, so you can change any parameter without rebuilding.
# Lines starting with `#` are comments; leave value blank to use the default
# baked into the entrypoint.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
SYSTEM_NAME="Disclosure-helper"
SYSTEM_VERSION="0.1"
# Path to the questions dictionary (relative to /app).
DIRECTORY_PATH="questions.json"
# Directory where generated .docx reports are written.
DOC_OUTPUT_DIR="./reports"
# Delay (seconds) between operations (declared in config; currently unused by app).
DELAY_SECOND=7

# -----------------------------------------------------------------------------
# Which remote service(s) to activate?
#   raw    = custom HTTP service (RawService)
#   open   = OpenAI-compatible service (OpenService)
#   google = Google Gemini (GoogleService)
# Comma-separated list activates several in order, e.g. "open,google".
# This is the main knob for "choose remote service".
# -----------------------------------------------------------------------------
REMOTE_SERVICE=raw

# -----------------------------------------------------------------------------
# Telegram bot
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_NAME=
# Comma-separated numeric user IDs, e.g. 123456789,987654321
TELEGRAM_ALLOWED_USER_ID=

# -----------------------------------------------------------------------------
# Database
#   Default: in-memory SQLite (matches config_test.yaml).
#   For a real DB, e.g. PostgreSQL:
#     DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/disclosure
# -----------------------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///file:mem_db?mode=memory&cache=shared&uri=true

# -----------------------------------------------------------------------------
# Remote service #1: OpenAI-compatible
# Used only when REMOTE_SERVICE contains "open".
# -----------------------------------------------------------------------------
OPEN_SERVICE_MODEL=
OPEN_SERVICE_URL=
OPEN_SERVICE_API_KEY=

# -----------------------------------------------------------------------------
# Remote service #2: custom HTTP service (RawService)
# Used only when REMOTE_SERVICE contains "raw".
# -----------------------------------------------------------------------------
RAW_SERVICE_MODEL=
RAW_SERVICE_URL=
RAW_SERVICE_API_KEY=

# -----------------------------------------------------------------------------
# Remote service #3: Google Gemini
# Used only when REMOTE_SERVICE contains "google".
# -----------------------------------------------------------------------------
GOOGLE_SERVICE_MODEL=
GOOGLE_SERVICE_API_KEY=

# -----------------------------------------------------------------------------
# Mail (SMTP)
#   use_tls = true  -> implicit TLS on port 465 (e.g. Yandex, Gmail)
#   use_tls = false -> STARTTLS on port 587
# MAIL_TO is a comma-separated list of recipients.
# -----------------------------------------------------------------------------
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SENDER=
MAIL_USE_TLS=true
MAIL_TO=
